<%layout('layout/boilerplate')%>
    <div id="map" style="width: 100% ;height: 500px;border: 1px solid #d1d1d1; box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1); border-radius: 8px; overflow: hidden;"></div>
    
  
    <h3 class="text-center fw-bold" style="font-family: 'Nunito', sans-serif; color: #012b18; font-size: 2rem; margin: 34px;">
        All Campgrounds
    </h3>

    
    
    
    <div class="text-end">
        <a href="/campgrounds/new" class="btn btn-primary" style="font-size: 1rem; padding: 8px 16px; border-radius: 6px;text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);">
            Add a Campground
        </a>
    </div
    
    <ul>
        <% for (let campground of campgrounds){ %>
        <div class="card mb-3">
            <div class="row">
                <div class="col-md-4">
                    <% if(campground.images.length){%> 
                        <img crossorigin="anonymous" src="<%=campground.images[0].cardImage%>" alt="No Image" class="img-fluid">
                    <%}else { %>
                        <img crossorigin="anonymous" src="https://res.cloudinary.com/dyrpryw0v/image/upload/ar_5:3,c_crop/v1740159718/YelpCamp/ag4a6e3v9kses2perpu3.avif" alt="No Image">
                    <% } %>   

                </div>
                <div class="col-md-8">
                    <div class="card-body">
                        <h5 class="card-title">
                            <%= campground.title %>
                        </h5>
                        <p class="card-text">
                            <%= campground.description %>
                        </p>
                        <p class="card-text">
                            <%= campground.location %>
                        </p>    
                        <a class="btn btn-secondary" href="/campgrounds/<%=campground._id%>">View <%=campground.title%></a>
                    
                    </div>

                </div>
            </div>
        </div>
        <% } %>
    </ul>

    <script>
        const maptilerApiKey='<%-process.env.MAPTILER_API_KEY%>';
        const campgrounds={features:<%-JSON.stringify(campgrounds)%>}
        //as the maptiler(in clusterMap.js) expects an array of objectdata which comes under the property key 'feature' as an object itself we format the campgrounds like this
    </script>

<script src="/javascripts/clusterMap.js"></script>

